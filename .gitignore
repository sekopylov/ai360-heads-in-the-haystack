# Keep only code, execution/dependency configuration and source datasets.
# Traverse directories so exceptions below can expose the allowed files.
*
!*/
!.gitignore

# Source code and executable notebooks.
!*.py
!*.ipynb
!*.sh
!*.bash
!*.ps1
!*.js
!*.ts
!*.jsx
!*.tsx
!*.html
!*.css
!*.c
!*.cpp
!*.h
!*.cu
!*.rs
!*.go
!*.sql
!*.jinja
!*.jinja2

# Run configurations and dependency/build specifications.
!*.yaml
!*.yml
!*.toml
!requirements*.txt
!uv.lock
!poetry.lock
!Makefile
!Dockerfile

# Dataset contents, including JSON needles and corpus text.
!/updated/data/**
!/source/PaulGrahamEssays/**
!/source/haystack_for_detect/**

# Never expose generated files or copied code from these directories.
.venv*/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.agent/
.agents/
.codex/
.aws/
.idea/
.vscode/
models/
/updated/report-assets/
/updated/datasphere-results/
/updated/outputs/
/updated/results/
/updated/contexts/
/updated/head_score/
/updated/attention/
/updated/runs/
/updated/detection/
/updated/evaluation/
/source/results/
/source/head_score/
