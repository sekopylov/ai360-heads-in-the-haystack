# Model weights (~3.2 GB total) are downloaded, never committed.
models/

# Environments and caches.
# `.cache/` is disposable by definition and stays fully ignored.  The one thing
# that lives there on purpose is the DataSphere IAM token
# (`.cache/datasphere/iam-token`, mode 600, written by scripts/datasphere_auth.sh)
# -- a secret, so it must never be committed.  Job configs are *not* cache: they
# are versioned under configs/datasphere/.
.venv/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/

# Run logs (the JSON/figures under results/ are the actual artefacts)
logs/

# Scratch space. NOTE: /tmp is wiped between tool calls in this sandbox, so
# scratch files must live here instead.
.tmp/

# Result blobs.  The `results/` (CPU) matrices are regenerated and stay ignored;
# the `ds-results/` (GPU) matrices *are* committed on purpose -- the tables and
# figures in the repo are derived from exactly those files, they are a few KB
# each, and a reader must be able to check a number without a GPU run.
results/**/*.npz

# Registry copy written by the job driver when it overrides the dtype; the
# tracked configs/models.json is never modified.
configs/models.runtime.json

# Logs pulled back from DataSphere jobs (evidence, but noisy in a diff)
ds-*-logs*/
ds-download/
ds-smoke-results/

# Staging tree for a resumed job: the previous run's artifacts are uploaded via
# `local-paths` so the remaining stages can reuse them (a copy, never the tracked
# ds-results/).
ds-resume/

# Windows "downloaded from the internet" metadata, pure noise in a repo
*:Zone.Identifier
